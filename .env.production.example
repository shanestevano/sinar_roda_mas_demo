# ============================================================
# RAILWAY PRODUCTION ENVIRONMENT CONFIGURATION
# Salin variabel ini ke menu "Variables" di Railway Dashboard
# ============================================================

APP_NAME="Sinar Roda Mas"
APP_ENV=production
APP_KEY=base64:GENERATE_DENGAN_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ============================================================
# OPSI DATABASE
# ============================================================
# Opsi 1: SQLite (Default bawaan aplikasi)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# Opsi 2: MySQL (Jika menambahkan plugin MySQL di Railway)
# Jika plugin MySQL ditambahkan, entrypoint otomatis mendeteksi MYSQL_URL.
# Atau dapat diisi manual:
# DB_CONNECTION=mysql
# DB_HOST=${{MYSQLHOST}}
# DB_PORT=${{MYSQLPORT}}
# DB_DATABASE=${{MYSQLDATABASE}}
# DB_USERNAME=${{MYSQLUSER}}
# DB_PASSWORD=${{MYSQLPASSWORD}}

# Opsi 3: PostgreSQL (Jika menambahkan plugin PostgreSQL di Railway)
# Jika plugin PostgreSQL ditambahkan, entrypoint otomatis mendeteksi DATABASE_URL.
# Atau dapat diisi manual:
# DB_CONNECTION=pgsql
# DB_URL=${{DATABASE_URL}}

# ============================================================
# DRIVER SESSION, CACHE & QUEUE
# ============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ============================================================
# AUTO MIGRATE & AUTO SEED
# ============================================================
# Jalankan migrasi otomatis saat container start
RUN_MIGRATIONS=true

# Aktifkan true pada deploy pertama kali untuk mengisi akun & data ban contoh
DB_SEED=true
